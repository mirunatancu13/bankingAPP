<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8">

    <!-- Text central -->
    <TextView
        android:id="@+id/text_goals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pagina Goals"
        android:textSize="24sp"
        android:textColor="#000000"
        android:fontFamily="@font/fontprincipal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="200dp" />

    <!-- 🟣 Bara de jos fixă -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:background="@color/purple"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@drawable/ic_home"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_discover"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Discover"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/goals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_goals"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Goals"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/simulation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_simulation"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Simulate"
            android:scaleType="fitCenter" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
